  "components": {
    "securitySchemes": {
      "FeedWriteToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "ofd_<256-bit base64url secret>",
        "description": "Created once in Data feeds; scoped to one feed, write only. Supply Authorization: Bearer <token>."
      },
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "openframe_session",
        "description": "Existing authenticated operator session; View/Edit and same-origin policy apply."
      }
    },
    "schemas": {
      "Field": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "type"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "number",
              "series",
              "categories"
            ]
          }
        }
      },
      "FeedDefinition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "fields"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "managingGroupId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Field"
            },
            "description": "Unique field keys. Definitions cannot be changed after creation."
          }
        }
      },
      "Feed": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "name",
              "fields"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "managingGroupId": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "$ref": "#/components/schemas/Field"
                },
                "description": "Unique field keys. Definitions cannot be changed after creation."
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "readOnly": {
                "type": "boolean"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "revision": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        ]
      },
      "SnapshotData": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 20,
        "description": "Complete snapshot: exactly the declared keys, each value matching its feed field type. This general schema cannot encode a feed-specific field definition. Series timestamps and category labels must be unique. Total encoded request <=32768 bytes. Null clears a number; [] clears a chart.",
        "additionalProperties": {
          "anyOf": [
            {
              "type": [
                "number",
                "null"
              ],
              "minimum": -1000000000000.0,
              "maximum": 1000000000000.0
            },
            {
              "type": "array",
              "maxItems": 240,
              "items": {
                "type": "object",
                "required": [
                  "time",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "time": {
                    "type": "string",
                    "format": "date-time",
                    "description": "ISO datetime with Z or explicit offset. Points must have strictly ascending unique timestamps."
                  },
                  "value": {
                    "type": "number",
                    "minimum": -1000000000000.0,
                    "maximum": 1000000000000.0
                  }
                }
              }
            },
            {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "value": {
                    "type": "number",
                    "minimum": -1000000000000.0,
                    "maximum": 1000000000000.0
                  }
                }
              }
            }
          ]
        }
      },
      "Snapshot": {
        "type": "object",
        "required": [
          "revision",
          "updatedAt",
          "data",
          "status"
        ],
        "properties": {
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "data": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SnapshotData"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "ready",
              "empty",
              "unavailable"
            ]
          }
        }
      },
      "UpdateReceipt": {
        "type": "object",
        "required": [
          "feedId",
          "revision",
          "updatedAt"
        ],
        "properties": {
          "feedId": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "string",
            "format": "uuid"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TokenRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "expiresInDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365,
            "default": 90
          }
        }
      },
      "TokenMetadata": {
        "type": "object",
        "required": [
          "id",
          "feedId",
          "name",
          "createdAt",
          "expiresAt",
          "revokedAt",
          "lastUsedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "feedId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "revokedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastUsedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "IssuedToken": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TokenMetadata"
          },
          {
            "type": "object",
            "required": [
              "token"
            ],
            "properties": {
              "token": {
                "type": "string",
                "pattern": "^ofd_[A-Za-z0-9_-]{43}$",
                "description": "One-time secret. Only its hash is stored; never included in subsequent reads."
              }
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Stable code on feed-handler errors; standard session-auth middleware may omit it."
          }
        }
      },
      "Ok": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "const": true
          }
        }
      }
    }
  }
}
