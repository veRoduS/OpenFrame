OPENFRAME_PORT=3100
# Use 127.0.0.1 when a VPN/HTTPS proxy runs directly on the Docker host.
OPENFRAME_BIND_ADDRESS=0.0.0.0
# Behind any HTTPS reverse proxy, tunnel, or load balancer, set:
# PUBLIC_URL=https://signage.example.com and COOKIE_SECURE=true.
# Use the browser-facing origin (scheme + hostname + non-default port), not the
# internal container address. No path. Recreate the container after changes;
# restart alone does not apply environment changes. See docs/operations.md.
PUBLIC_URL=
COOKIE_SECURE=false
