# Copy to .env.managed. Do not commit the configured file.
# This hostname must resolve directly to your home public IP (DNS-only, not proxied).
WG_ENDPOINT=vpn.example.com:51820
WG_PORT=51820
# Choose an unused private /24 prefix before enrolling any screens. Keep it stable.
WG_PREFIX=10.77.0
# Loopback by default for private initial setup or a same-host Cloudflare connector.
OPENFRAME_BIND_ADDRESS=127.0.0.1
OPENFRAME_PORT=3100
# Configure these after creating the administrator on the trusted local connection.
PUBLIC_URL=
COOKIE_SECURE=false
