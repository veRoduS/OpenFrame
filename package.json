{
  "name": "openframe",
  "version": "0.12.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "vite build",
    "build:android": "node scripts/build-android.mjs",
    "publish:android": "node scripts/publish-android.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:patch": "node scripts/version.mjs patch",
    "version:milestone": "node scripts/version.mjs minor",
    "version:major": "node scripts/version.mjs major",
    "version:player:patch": "node scripts/version.mjs player patch",
    "version:player:milestone": "node scripts/version.mjs player minor",
    "version:player:major": "node scripts/version.mjs player major",
    "compatibility:check": "node scripts/compatibility.mjs check",
    "compatibility:review": "node scripts/compatibility.mjs review",
    "repository:check": "node scripts/check-repository.mjs",
    "icons:generate": "node scripts/generate-player-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint app server tests player/web player/setup-web scripts",
    "format": "oxfmt --ignore-path .formatignore app server tests player/web player/setup-web scripts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "fflate": "0.8.3",
    "multer": "^2.4.0",
    "sharp": "0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "uuid": "11.1.1",
    "vite": "8.0.16"
  },
  "type": "module"
}
