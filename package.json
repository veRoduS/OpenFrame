    "embla-carousel-react": "8.5.2",
    "express": "^5.2.1",
    "fflate": "0.8.3",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "multer": "^2.3.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
